# Copy to .env and fill in. NEVER commit .env
#
# Composio API key — get it from https://app.composio.dev
# Leave empty if you already ran `composio login`.
COMPOSIO_API_KEY=

# Your identity, used in templates and the From header.
SENDER_NAME=Your Name
SENDER_EMAIL=you@example.com
SENDER_PHONE=+62 8xx-xxxx-xxxx
SENDER_LINKEDIN=linkedin.com/in/yourhandle
